{
  "name": "fittrack",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace api && npm run build --workspace web",
    "test": "npm run test --workspace api",
    "db:generate": "npm run db:generate --workspace api",
    "db:migrate": "npm run db:migrate --workspace api",
    "db:seed": "npm run db:seed --workspace api"
  },
  "devDependencies": {
    "concurrently": "9.2.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
